# EditorConfig: https://editorconfig.org
# Goal: consistent formatting across editors/IDEs for Go / TS / Markdown
# without reformatting any existing files.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.go]
indent_style = tab

[*.{ts,tsx,js,json,css,html}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
