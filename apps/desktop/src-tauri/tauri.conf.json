{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MultiAgentLab",
  "version": "1.0.0",
  "identifier": "com.multiagentlab.desktop",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "智能体构建平台",
        "url": "index.html",
        "width": 1152,
        "height": 720,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "resources/web-dist": "web-dist",
      "resources/migrations": "migrations",
      "resources/docs": "docs",
      "resources/platform-knowledge": "platform-knowledge",
      "resources/research": "research",
      "resources/tools": "tools"
    },
    "externalBin": [
      "bin/backend",
      "bin/ontologyd",
      "bin/runtimed",
      "bin/oxigraph"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
